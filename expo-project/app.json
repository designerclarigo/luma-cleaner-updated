{
  "expo": {
    "name": "Luma",
    "slug": "luma-gallery-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "luma",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luma.cleaner",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Luma uses your photos and videos for local cleanup reviews. You choose which items to keep or submit for system-confirmed deletion.",
        "NSPhotoLibraryAddUsageDescription": "Allow Luma to update your photo library when you approve changes."
      }
    },
    "android": {
      "package": "com.luma.cleaner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F7F3"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_MEDIA",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-media-library",
        {
          "photosPermission": "Luma uses your photos and videos for local cleanup reviews. You choose which items to keep or submit for system-confirmed deletion.",
          "savePhotosPermission": "Allow Luma to update your photo library when you approve changes.",
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6"
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Choose photos and videos to review in Luma."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1225fdc-c3d0-4c47-9aee-a31c9c09289e"
      }
    },
    "owner": "ayuglows-team"
  }
}
